---
import { getCollection } from "astro:content";

// Fetch all non-draft blog posts sorted newest first
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

function highlight(text: string): string {
  return text.replace(
    /\*\*(.+?)\*\*/g,
    '<span class="text-emerald-500">$1</span>',
  );
}
---

<main class="max-w-3xl mx-auto px-6 text-[17px] py-10">
  <!-- Top Navigation -->
  <nav class="flex items-center justify-between pb-8">
    <a href="/" class="plain-link text-sm font-medium">
      &larr; Back to Home
    </a>
    <span class="font-mono text-xs text-neutral-400">
      {posts.length} {posts.length === 1 ? "article" : "articles"}
    </span>
  </nav>

  <!-- Header -->
  <header class="pb-10 border-b border-neutral-200">
    <p class="mb-3 font-mono text-sm text-emerald-500">$ ls -l ~/blogs</p>
    <h1 class="rowdies-bold text-3xl md:text-4xl text-neutral-900">
      <Fragment set:html={highlight("Blogs & **Articles**")} />
    </h1>
    <p class="mt-3 text-neutral-600 leading-relaxed">
      Thoughts, tutorials, and practical insights on DevOps, Linux homelabs, cloud infrastructure, and full-stack engineering.
    </p>
  </header>

  <!-- Posts Listing -->
  <section class="py-6 divide-y divide-neutral-200">
    {
      posts.length === 0 ? (
        <div class="py-12 text-center text-neutral-500">
          <p class="font-mono text-sm">$ echo "No posts published yet."</p>
        </div>
      ) : (
        posts.map((post) => {
          const formattedDate = new Intl.DateTimeFormat("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          }).format(new Date(post.data.date));

          return (
            <article class="py-8 group">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="font-mono text-xs text-emerald-600"
                >
                  {formattedDate}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag: string) => (
                      <span class="inline-block bg-neutral-200/60 text-neutral-700 font-mono text-xs px-2 py-0.5 rounded">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <h2 class="text-2xl font-bold text-neutral-900 group-hover:text-emerald-600 transition-colors">
                <a href={`/blogs/${post.id}`} class="no-underline text-neutral-900 hover:text-emerald-600 transition-colors">
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="mt-2 text-neutral-600 leading-relaxed">
                  {post.data.description}
                </p>
              )}

              <div class="mt-4">
                <a
                  href={`/blogs/${post.id}`}
                  class="plain-link text-sm font-medium text-emerald-600 inline-flex items-center gap-1"
                >
                  Read article &rarr;
                </a>
              </div>
            </article>
          );
        })
      )
    }
  </section>

  <!-- Footer Navigation -->
  <footer class="pt-8 mt-12 border-t border-neutral-200 flex justify-between items-center text-sm text-neutral-500">
    <a href="/" class="plain-link">
      &larr; Back to Home
    </a>
    <a href="#top" class="plain-link">
      Back to top &uarr;
    </a>
  </footer>
</main>

<style>
  .plain-link {
    border-bottom: 1px solid #000;
    text-decoration: none;
    color: inherit;
  }
  .plain-link:hover {
    color: #34d399;
  }
</style>
