---
import { getCollection } from "astro:content";

// Fetch all non-draft projects, sorted featured first, then by date descending
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

function highlight(text: string): string {
  return text.replace(
    /\*\*(.+?)\*\*/g,
    '<span class="text-emerald-500">$1</span>',
  );
}
---

<main class="max-w-3xl mx-auto px-6 text-[17px] py-10">
  <!-- Top Navigation -->
  <nav class="flex items-center justify-between pb-8">
    <a href="/" class="plain-link text-sm font-medium">
      &larr; Back to Home
    </a>
    <span class="font-mono text-xs text-neutral-400">
      {projects.length} {projects.length === 1 ? "project" : "projects"}
    </span>
  </nav>

  <!-- Header -->
  <header class="pb-10 border-b border-neutral-200">
    <p class="mb-3 font-mono text-sm text-emerald-500">$ cat ~/projects.json</p>
    <h1 class="rowdies-bold text-3xl md:text-4xl text-neutral-900">
      <Fragment set:html={highlight("Featured **Projects**")} />
    </h1>
    <p class="mt-3 text-neutral-600 leading-relaxed">
      A showcase of web applications, cloud infrastructure, DevOps pipelines, and systems experiments.
    </p>
  </header>

  <!-- Projects Listing -->
  <section class="py-6 divide-y divide-neutral-200">
    {
      projects.length === 0 ? (
        <div class="py-12 text-center text-neutral-500">
          <p class="font-mono text-sm">$ echo "No projects added yet."</p>
        </div>
      ) : (
        projects.map((project) => {
          const formattedDate = new Intl.DateTimeFormat("en-US", {
            year: "numeric",
            month: "short",
          }).format(new Date(project.data.date));

          return (
            <article class="py-8 group">
              <header class="mb-3">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    {project.data.featured && (
                      <span class="bg-emerald-100 text-emerald-800 font-mono text-xs font-semibold px-2 py-0.5 rounded">
                        Featured
                      </span>
                    )}
                    <span class="font-mono text-xs text-neutral-400">
                      {formattedDate}
                    </span>
                  </div>

                  <div class="flex items-center gap-4 text-sm">
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="plain-link font-medium text-emerald-600"
                      >
                        Live Demo &rarr;
                      </a>
                    )}
                    {project.data.repoUrl && (
                      <a
                        href={project.data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="plain-link text-neutral-600"
                      >
                        Source Code &nearr;
                      </a>
                    )}
                  </div>
                </div>

                <h2 class="text-2xl font-bold text-neutral-900 group-hover:text-emerald-600 transition-colors">
                  <a href={`/projects/${project.id}`} class="no-underline text-neutral-900 hover:text-emerald-600 transition-colors">
                    {project.data.title}
                  </a>
                </h2>

                <p class="mt-2 text-neutral-600 leading-relaxed">
                  {project.data.description}
                </p>

                {project.data.tech && project.data.tech.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {project.data.tech.map((t: string) => (
                      <span class="inline-block bg-neutral-200/60 text-neutral-700 font-mono text-xs px-2.5 py-0.5 rounded">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </header>

              <div class="mt-4">
                <a
                  href={`/projects/${project.id}`}
                  class="plain-link text-sm font-medium text-emerald-600 inline-flex items-center gap-1"
                >
                  View project case study &rarr;
                </a>
              </div>
            </article>
          );
        })
      )
    }
  </section>

  <!-- Footer Navigation -->
  <footer class="pt-8 mt-12 border-t border-neutral-200 flex justify-between items-center text-sm text-neutral-500">
    <a href="/" class="plain-link">
      &larr; Back to Home
    </a>
    <a href="#top" class="plain-link">
      Back to top &uarr;
    </a>
  </footer>
</main>

<style>
  .plain-link {
    border-bottom: 1px solid #000;
    text-decoration: none;
    color: inherit;
  }
  .plain-link:hover {
    color: #34d399;
  }
</style>
